{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagnos-tech.github.io/audit/schemas/v1/signers.schema.json",
  "title": "Release signers",
  "description": "For each audited service, the only build identity whose signatures count: a GitHub Actions workflow on one ref of one repository, identified by the repository's and owner's numeric ids (which survive renames and cannot be re-registered). Stored at keys/signers.json. The auditor is configured with the same values; VERIFY.md turns each entry into cosign flags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "services"],
  "properties": {
    "schema": { "const": "signers/v1" },
    "services": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/serviceId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "repository", "repositoryId", "ownerId", "workflow", "ref"],
        "properties": {
          "issuer": { "const": "https://token.actions.githubusercontent.com" },
          "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "repositoryId": { "type": "string", "pattern": "^[0-9]{1,20}$" },
          "ownerId": { "type": "string", "pattern": "^[0-9]{1,20}$" },
          "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" },
          "ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" }
        }
      }
    }
  }
}
