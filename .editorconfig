# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The page, the schemas, the data and the docs use two spaces.
[*.{html,css,js,json,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 100

# gofmt indents Go with tabs; go.mod and go.sum are written by the Go tool.
[{*.go,go.mod,go.sum,go.work}]
indent_style = tab

[*.sh]
indent_size = 2

# Data files are written by the witness and pinned by their SHA-256: an editor must never touch them.
[{data/**,examples/data/**}]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset

# Verbatim licence texts.
[{LICENSE,LICENSES/**}]
trim_trailing_whitespace = unset
insert_final_newline = unset
